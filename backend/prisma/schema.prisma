generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  engineType          = "client"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  generatedFileExtension = "ts"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id           String         @id @default(uuid()) @db.Uuid
  email        String         @unique @db.VarChar(320)
  name         String         @default("Store Admin") @db.VarChar(120)
  passwordHash String         @map("password_hash") @db.VarChar(255)
  sessions     AdminSession[]
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  @@map("admins")
}

model AdminSession {
  id        String   @id @db.Uuid
  adminId   String   @map("admin_id") @db.Uuid
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([adminId])
  @@index([expiresAt])
  @@map("admin_sessions")
}

model LoginAttempt {
  key         String   @id @db.VarChar(64)
  attempts    Int      @default(1)
  windowStart DateTime @default(now()) @map("window_start")
  expiresAt   DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("login_attempts")
}

model Category {
  id            String    @id @db.VarChar(80)
  nameEn        String    @map("name_en") @db.VarChar(160)
  nameAr        String    @map("name_ar") @db.VarChar(160)
  descriptionEn String    @default("") @map("description_en") @db.Text
  descriptionAr String    @default("") @map("description_ar") @db.Text
  imageUrl      String    @map("image_url") @db.Text
  active        Boolean   @default(true)
  displayOrder  Int       @default(0) @map("display_order")
  products      Product[]
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([active, displayOrder])
  @@map("categories")
}

model Product {
  id            String           @id @db.VarChar(120)
  nameEn        String           @map("name_en") @db.VarChar(200)
  nameAr        String           @map("name_ar") @db.VarChar(200)
  descriptionEn String           @default("") @map("description_en") @db.Text
  descriptionAr String           @default("") @map("description_ar") @db.Text
  categoryId    String           @map("category_id") @db.VarChar(80)
  category      Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand         String           @db.VarChar(160)
  imageUrl      String           @map("image_url") @db.Text
  price         Decimal?         @db.Decimal(14, 2)
  currency      String           @default("SYP") @db.VarChar(8)
  quantity      Int?
  featured      Boolean          @default(false)
  isNew         Boolean          @default(false) @map("is_new")
  active        Boolean          @default(true)
  displayOrder  Int              @default(0) @map("display_order")
  variants      ProductVariant[]
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  @@index([active, displayOrder])
  @@index([categoryId, active])
  @@index([featured, active])
  @@map("products")
}

model ProductVariant {
  id            String   @id @default(uuid()) @db.Uuid
  productId     String   @map("product_id") @db.VarChar(120)
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  value         String   @db.VarChar(32)
  imageUrl      String   @map("image_url") @db.Text
  nameEn        String?  @map("name_en") @db.VarChar(200)
  nameAr        String?  @map("name_ar") @db.VarChar(200)
  descriptionEn String?  @map("description_en") @db.Text
  descriptionAr String?  @map("description_ar") @db.Text
  displayOrder  Int      @default(0) @map("display_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([productId, displayOrder])
  @@map("product_variants")
}

model HeroContent {
  id               String   @id @default("default") @db.VarChar(40)
  eyebrowEn        String   @map("eyebrow_en") @db.VarChar(200)
  eyebrowAr        String   @map("eyebrow_ar") @db.VarChar(200)
  titleStartEn     String   @map("title_start_en") @db.VarChar(220)
  titleStartAr     String   @map("title_start_ar") @db.VarChar(220)
  titleAccentEn    String   @map("title_accent_en") @db.VarChar(220)
  titleAccentAr    String   @map("title_accent_ar") @db.VarChar(220)
  titleEndEn       String   @map("title_end_en") @db.VarChar(220)
  titleEndAr       String   @map("title_end_ar") @db.VarChar(220)
  bodyEn           String   @map("body_en") @db.Text
  bodyAr           String   @map("body_ar") @db.Text
  primaryCtaEn     String   @map("primary_cta_en") @db.VarChar(120)
  primaryCtaAr     String   @map("primary_cta_ar") @db.VarChar(120)
  secondaryCtaEn   String   @map("secondary_cta_en") @db.VarChar(120)
  secondaryCtaAr   String   @map("secondary_cta_ar") @db.VarChar(120)
  noteEn           String   @map("note_en") @db.VarChar(200)
  noteAr           String   @map("note_ar") @db.VarChar(200)
  cardLabelEn      String   @map("card_label_en") @db.VarChar(160)
  cardLabelAr      String   @map("card_label_ar") @db.VarChar(160)
  cardTitleEn      String   @map("card_title_en") @db.VarChar(160)
  cardTitleAr      String   @map("card_title_ar") @db.VarChar(160)
  mainImageUrl     String   @map("main_image_url") @db.Text
  detailImageUrl   String   @map("detail_image_url") @db.Text
  visible          Boolean  @default(true)
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("hero_content")
}

model AboutContent {
  id                String   @id @default("default") @db.VarChar(40)
  eyebrowEn         String   @map("eyebrow_en") @db.VarChar(200)
  eyebrowAr         String   @map("eyebrow_ar") @db.VarChar(200)
  titleEn           String   @map("title_en") @db.VarChar(260)
  titleAr           String   @map("title_ar") @db.VarChar(260)
  bodyEn            String   @map("body_en") @db.Text
  bodyAr            String   @map("body_ar") @db.Text
  quoteEn           String   @map("quote_en") @db.Text
  quoteAr           String   @map("quote_ar") @db.Text
  mainImageUrl      String   @map("main_image_url") @db.Text
  secondaryImageUrl String   @map("secondary_image_url") @db.Text
  visible           Boolean  @default(true)
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("about_content")
}

model Highlight {
  id            String   @id @default(uuid()) @db.Uuid
  icon          String   @db.VarChar(32)
  titleEn       String   @map("title_en") @db.VarChar(180)
  titleAr       String   @map("title_ar") @db.VarChar(180)
  bodyEn        String   @map("body_en") @db.Text
  bodyAr        String   @map("body_ar") @db.Text
  active        Boolean  @default(true)
  displayOrder  Int      @default(0) @map("display_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([active, displayOrder])
  @@map("highlights")
}

model ContactSettings {
  id                 String   @id @default("default") @db.VarChar(40)
  sectionEyebrowEn   String   @map("section_eyebrow_en") @db.VarChar(200)
  sectionEyebrowAr   String   @map("section_eyebrow_ar") @db.VarChar(200)
  sectionTitleEn     String   @map("section_title_en") @db.VarChar(260)
  sectionTitleAr     String   @map("section_title_ar") @db.VarChar(260)
  sectionBodyEn      String   @map("section_body_en") @db.Text
  sectionBodyAr      String   @map("section_body_ar") @db.Text
  addressEn          String   @map("address_en") @db.Text
  addressAr          String   @map("address_ar") @db.Text
  phoneDisplay       String   @map("phone_display") @db.VarChar(60)
  phoneInternational String   @map("phone_international") @db.VarChar(32)
  whatsappNumber     String   @map("whatsapp_number") @db.VarChar(32)
  email              String   @db.VarChar(320)
  mapsUrl            String   @map("maps_url") @db.Text
  contactImageUrl    String   @map("contact_image_url") @db.Text
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("contact_settings")
}

model SocialLink {
  id           String   @id @db.VarChar(40)
  url          String   @default("") @db.Text
  enabled      Boolean  @default(false)
  displayOrder Int      @default(0) @map("display_order")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([enabled, displayOrder])
  @@map("social_links")
}

model SiteSettings {
  id                  String   @id @default("default") @db.VarChar(40)
  storeNameEn         String   @map("store_name_en") @db.VarChar(180)
  storeNameAr         String   @map("store_name_ar") @db.VarChar(180)
  footerTitleEn       String   @map("footer_title_en") @db.VarChar(260)
  footerTitleAr       String   @map("footer_title_ar") @db.VarChar(260)
  footerDescriptionEn String   @map("footer_description_en") @db.Text
  footerDescriptionAr String   @map("footer_description_ar") @db.Text
  logoUrl             String   @default("") @map("logo_url") @db.Text
  faviconUrl          String   @default("") @map("favicon_url") @db.Text
  seoTitleEn          String   @map("seo_title_en") @db.VarChar(260)
  seoTitleAr          String   @map("seo_title_ar") @db.VarChar(260)
  metaDescriptionEn   String   @map("meta_description_en") @db.Text
  metaDescriptionAr   String   @map("meta_description_ar") @db.Text
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}
