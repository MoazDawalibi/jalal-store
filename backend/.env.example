# Use a pooled PostgreSQL connection for serverless runtime traffic.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# At least 32 random characters. Rotate to invalidate all sessions.
AUTH_SECRET=
AUTH_TOKEN_HOURS=12

# Exact deployed frontend origins, without trailing slashes.
WEBSITE_URL=
DASHBOARD_URL=

# Vercel Blob write token. Required for production uploads.
BLOB_READ_WRITE_TOKEN=

# Optional initial admin / seed values.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Store Admin
SEED_ASSET_BASE_URL=

PORT=3000
NODE_ENV=development
